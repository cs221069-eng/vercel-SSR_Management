<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <% const admins = data.admins || []; %>
    <div class="flex min-h-screen flex-col bg-background-light font-display text-slate-900 md:flex-row">
      <aside class="flex w-full flex-shrink-0 flex-col border-b border-slate-200 bg-white py-4 md:w-64 md:border-b-0 md:border-r md:py-6">
        <div class="px-4 md:px-6">
          <h1 class="text-lg font-bold text-primary">FYP Central</h1>
          <p class="mt-1 text-xs text-slate-500">Admin Portal</p>
          <nav class="mt-4 flex flex-wrap gap-2 md:mt-8 md:block md:space-y-2">
            <a class="block rounded-lg px-3 py-2.5 text-sm whitespace-nowrap hover:bg-slate-50" href="/admin-dashboard-1">Dashboard</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm whitespace-nowrap hover:bg-slate-50" href="/admin-dashboard-2">User</a>
            <a class="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-semibold text-primary" href="/admin-dashboard-3">Create User</a>
            <form action="/logout" method="post"><button class="block w-full rounded-lg px-3 py-2.5 text-left text-sm hover:bg-slate-50" type="submit">Logout</button></form>
          </nav>
        </div>
      </aside>

      <main class="flex-1 overflow-y-auto">
        <header class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6 md:px-8">
          <h1 class="text-lg font-bold sm:text-xl">Create User</h1>
        </header>

        <div class="space-y-6 p-4 sm:p-6 md:space-y-8 md:p-8">
          <% if (error) { %><div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error %></div><% } %>
          <% if (success) { %><div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700"><%= success %></div><% } %>

          <div class="overflow-hidden rounded-xl border border-primary/10 bg-white shadow-sm">
            <div class="overflow-x-auto">
              <table class="w-full min-w-[640px] text-left">
                <thead class="bg-primary/5">
                  <tr>
                    <th class="px-6 py-4 text-sm font-semibold text-slate-700">Email</th>
                    <th class="px-6 py-4 text-sm font-semibold text-slate-700">Role</th>
                    <th class="px-6 py-4 text-right text-sm font-semibold text-slate-700">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-primary/5">
                  <% if (admins.length === 0) { %><tr><td class="px-6 py-4 text-sm text-slate-500" colspan="3">No admins found.</td></tr><% } %>
                  <% admins.forEach(function(admin) { %>
                    <tr>
                      <td class="px-6 py-4 text-sm font-medium"><%= admin.email %></td>
                      <td class="px-6 py-4 text-sm">admin</td>
                      <td class="px-6 py-4 text-right text-sm font-semibold text-green-700">Active</td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="w-full max-w-md overflow-hidden rounded-xl border border-primary/10 bg-white shadow-2xl">
            <div class="border-b border-primary/5 px-6 py-6">
              <h3 class="text-xl font-bold text-slate-900">Create New User</h3>
              <p class="mt-1 text-sm text-slate-500">Invite a new member to your workspace.</p>
            </div>
            <form action="/admin/users/create" method="post" class="space-y-4 p-6">
              <div><label class="text-sm font-semibold text-slate-700">Full Name</label><input class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" placeholder="John Doe" type="text" name="name" /></div>
              <div><label class="text-sm font-semibold text-slate-700">Email Address</label><input class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" placeholder="john@example.com" type="email" name="email" /></div>
              <div><label class="text-sm font-semibold text-slate-700">Password</label><input class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" placeholder="Enter password" type="password" name="password" /></div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div><label class="text-sm font-semibold text-slate-700">Role</label><select class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" name="role"><option value="student">student</option><option value="teacher">teacher</option></select></div>
                <div><label class="text-sm font-semibold text-slate-700">Department</label><input class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" placeholder="Design" type="text" name="department" /></div>
              </div>
              <div class="flex items-center gap-3 pt-4">
                <a class="flex-1 rounded-lg bg-slate-100 px-4 py-2.5 text-center text-sm font-bold text-slate-600" href="/admin-dashboard-2">Cancel</a>
                <button class="flex-1 rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-white" type="submit">Create User</button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
