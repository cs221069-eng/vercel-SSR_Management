<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <% const metrics = data.metrics || {}; %>
    <% const queue = data.committeeQueue || []; %>
    <div class="flex min-h-screen flex-col bg-background-light font-display text-slate-900 md:flex-row">
      <aside class="flex w-full flex-shrink-0 flex-col border-b border-slate-200 bg-white py-4 md:w-64 md:border-b-0 md:border-r md:py-6">
        <div class="px-4 md:px-6">
          <h1 class="text-lg font-bold text-primary">FYP Central</h1>
          <p class="mt-1 text-xs text-slate-500">Admin Portal</p>
          <nav class="mt-4 flex flex-wrap gap-2 md:mt-8 md:block md:space-y-2">
            <a class="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-semibold text-primary" href="/admin-dashboard-1">Dashboard</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm whitespace-nowrap hover:bg-slate-50" href="/admin-dashboard-2">User</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm whitespace-nowrap hover:bg-slate-50" href="/admin-dashboard-3">Create User</a>
            <form action="/logout" method="post"><button class="block w-full rounded-lg px-3 py-2.5 text-left text-sm hover:bg-slate-50" type="submit">Logout</button></form>
          </nav>
        </div>
      </aside>

      <main class="flex flex-1 flex-col overflow-y-auto">
        <header class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6 md:px-8">
          <h2 class="text-sm font-bold sm:text-base">Academic Year Overview</h2>
          <div class="text-xs text-slate-500 sm:text-sm"><%= auth?.email || "Admin" %></div>
        </header>

        <div class="space-y-6 p-4 sm:p-6 md:space-y-8 md:p-8">
          <% if (error) { %><div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error %></div><% } %>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-slate-500">Total Students</p><h3 class="mt-1 text-3xl font-bold"><%= metrics.studentCount || 0 %></h3></div>
            <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-slate-500">Total Teachers</p><h3 class="mt-1 text-3xl font-bold"><%= metrics.teacherCount || 0 %></h3></div>
            <div class="rounded-xl border border-slate-100 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-slate-500">Committee Approved</p><h3 class="mt-1 text-3xl font-bold"><%= metrics.committeeApproved || 0 %></h3></div>
          </div>

          <div class="overflow-hidden rounded-xl border border-slate-100 bg-white shadow-sm">
            <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-6 py-5">
              <h3 class="font-bold">Committee Approval Queue</h3>
              <button type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600" onclick="window.location.reload()">Refresh</button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[640px] text-left">
                <thead class="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                  <tr>
                    <th class="px-6 py-4">Student</th>
                    <th class="px-6 py-4">Project Title</th>
                    <th class="px-6 py-4">Supervisor</th>
                    <th class="px-6 py-4">Teacher Status</th>
                    <th class="px-6 py-4">Committee</th>
                    <th class="px-6 py-4 text-center">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% if (queue.length === 0) { %><tr><td class="px-6 py-4 text-sm text-slate-500" colspan="6">No accepted proposals are waiting for committee decision.</td></tr><% } %>
                  <% queue.forEach(function(project) { %>
                    <tr>
                      <td class="px-6 py-4"><p class="text-sm font-semibold"><%= project?.students?.name || "Unknown" %></p><p class="text-xs text-slate-500"><%= project?.students?.email || "-" %></p></td>
                      <td class="px-6 py-4 text-sm font-semibold"><%= project?.title || "-" %></td>
                      <td class="px-6 py-4 text-sm text-slate-500"><%= project?.supervisor || "-" %></td>
                      <td class="px-6 py-4"><span class="rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-black text-emerald-700">Accepted</span></td>
                      <td class="px-6 py-4"><span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-black text-amber-700">Pending</span></td>
                      <td class="px-6 py-4">
                        <div class="flex items-center justify-center gap-2">
                          <button type="button" data-committee-action="approve" data-project-id="<%= project._id %>" class="rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">Approve</button>
                          <button type="button" data-committee-action="reject" data-project-id="<%= project._id %>" class="rounded-lg border border-red-300 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700">Reject</button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
