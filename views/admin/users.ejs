<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <% const users = data.data || []; %>
    <% const pagination = data.pagination || {}; %>
    <div class="flex min-h-screen flex-col bg-background-light font-display text-slate-900 md:flex-row">
      <aside class="flex w-full flex-shrink-0 flex-col border-b border-slate-200 bg-white py-4 md:w-64 md:border-b-0 md:border-r md:py-6">
        <div class="px-4 md:px-6">
          <h1 class="text-lg font-bold text-primary">FYP Central</h1>
          <p class="mt-1 text-xs text-slate-500">Admin Portal</p>
          <nav class="mt-4 flex flex-wrap gap-2 md:mt-8 md:block md:space-y-2">
            <a class="block rounded-lg px-3 py-2.5 text-sm whitespace-nowrap hover:bg-slate-50" href="/admin-dashboard-1">Dashboard</a>
            <a class="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-semibold text-primary" href="/admin-dashboard-2">User</a>
            <a class="block rounded-lg px-3 py-2.5 text-sm whitespace-nowrap hover:bg-slate-50" href="/admin-dashboard-3">Create User</a>
            <form action="/logout" method="post"><button class="block w-full rounded-lg px-3 py-2.5 text-left text-sm hover:bg-slate-50" type="submit">Logout</button></form>
          </nav>
        </div>
      </aside>

      <main class="flex flex-1 flex-col overflow-hidden">
        <header class="flex h-16 shrink-0 items-center border-b border-slate-200 bg-white px-4 sm:px-6 md:px-8"><h1 class="text-lg font-bold sm:text-xl">User Management</h1></header>
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 md:p-8">
          <% if (error) { %><div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error %></div><% } %>
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-left">
                <thead><tr class="border-b border-slate-200 bg-slate-50"><th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Name</th><th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Role</th><th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Department</th><th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th><th class="px-6 py-4 text-center text-xs font-bold uppercase tracking-wider text-slate-500">Actions</th></tr></thead>
                <tbody class="divide-y divide-slate-100">
                  <% if (users.length === 0) { %><tr><td class="px-6 py-4 text-sm text-slate-500" colspan="5">No users found.</td></tr><% } %>
                  <% users.forEach(function(user) { %>
                    <tr class="hover:bg-slate-50">
                      <td class="px-6 py-4 text-sm font-bold"><%= user.name %></td>
                      <td class="px-6 py-4"><span class="rounded-full bg-blue-100 px-2 py-1 text-xs font-semibold capitalize text-blue-700"><%= user.role %></span></td>
                      <td class="px-6 py-4 text-sm text-slate-600"><%= user.department %></td>
                      <td class="px-6 py-4 text-sm capitalize text-emerald-600"><%= user.status %></td>
                      <td class="px-6 py-4"><div class="flex items-center justify-center gap-3 text-slate-500"><button class="transition-colors hover:text-blue-600" type="button" data-edit-user data-user='<%- JSON.stringify(user) %>'><span class="material-symbols-outlined !text-[20px]">edit</span></button><button class="transition-colors hover:text-red-600" type="button" data-delete-user data-user-id="<%= user._id %>"><span class="material-symbols-outlined !text-[20px]">delete</span></button></div></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="flex flex-col gap-3 border-t border-slate-200 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-slate-500">Showing page <%= pagination.currentPage || 1 %> of <%= pagination.totalPages || 1 %> (<%= pagination.totalUsers || users.length %> users)</p>
              <div class="flex items-center gap-2">
                <% if ((pagination.currentPage || 1) > 1) { %><a href="/admin-dashboard-2?page=<%= pagination.currentPage - 1 %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-600">Previous</a><% } %>
                <% if ((pagination.currentPage || 1) < (pagination.totalPages || 1)) { %><a href="/admin-dashboard-2?page=<%= pagination.currentPage + 1 %>" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-600">Next</a><% } %>
              </div>
            </div>
          </div>
        </div>
      </main>

      <dialog id="edit-user-dialog" class="rounded-xl bg-white shadow-xl">
        <div class="w-full max-w-lg rounded-xl border border-slate-200 bg-white shadow-xl">
          <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4"><h2 class="text-lg font-bold">Edit User</h2><button type="button" class="text-slate-500 hover:text-slate-700" data-close-dialog="#edit-user-dialog"><span class="material-symbols-outlined">close</span></button></div>
          <form id="edit-user-form" class="space-y-4 p-5">
            <input type="hidden" name="id" />
            <div><label class="text-sm font-semibold text-slate-700">Full Name</label><input class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" type="text" name="name" /></div>
            <div><label class="text-sm font-semibold text-slate-700">Email Address</label><input class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" type="email" name="email" /></div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div><label class="text-sm font-semibold text-slate-700">Role</label><select class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" name="role"><option value="student">student</option><option value="teacher">teacher</option></select></div>
              <div><label class="text-sm font-semibold text-slate-700">Status</label><select class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" name="status"><option value="active">active</option><option value="inactive">inactive</option></select></div>
            </div>
            <div><label class="text-sm font-semibold text-slate-700">Department</label><input class="mt-1 w-full rounded-lg border border-primary/10 bg-primary/5 px-4 py-2.5" type="text" name="department" /></div>
            <div class="flex items-center gap-3 pt-2"><button type="button" class="flex-1 rounded-lg bg-slate-100 px-4 py-2.5 text-sm font-bold text-slate-600" data-close-dialog="#edit-user-dialog">Cancel</button><button type="submit" class="flex-1 rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-white">Save Changes</button></div>
          </form>
        </div>
      </dialog>
    </div>
  </body>
</html>
