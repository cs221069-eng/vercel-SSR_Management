<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <% const projects = data.projects || []; %>
    <% const teacherStudents = data.dashboard?.students || []; %>
    <div class="flex min-h-screen flex-col bg-background-light font-display text-slate-900 lg:flex-row">
      <aside class="flex w-full flex-col border-b border-slate-200 bg-white lg:fixed lg:h-full lg:w-64 lg:border-b-0 lg:border-r">
        <div class="flex items-center gap-3 p-6">
          <div class="flex size-10 items-center justify-center rounded-lg bg-primary text-white">
            <span class="material-symbols-outlined">school</span>
          </div>
          <div>
            <h1 class="text-lg font-bold leading-tight text-primary">FYP Portal</h1>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Teacher Edition</p>
          </div>
        </div>
        <nav class="flex-1 px-4 pb-4 lg:py-4 lg:pb-0">
          <div class="flex gap-2 overflow-x-auto pb-1 lg:block lg:space-y-1 lg:overflow-visible">
            <a href="/teacher-dashboard-1" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap">
              <span class="material-symbols-outlined">dashboard</span><span>Dashboard</span>
            </a>
            <a href="/teacher-dashboard-2" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap">
              <span class="material-symbols-outlined">group</span><span>My Students</span>
            </a>
            <a href="/teacher-projects" class="flex items-center gap-3 rounded-lg bg-primary/10 px-3 py-2.5 font-semibold text-primary whitespace-nowrap">
              <span class="material-symbols-outlined">assignment</span><span>Projects</span>
            </a>
            <a href="/teacher-reports" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap">
              <span class="material-symbols-outlined">assessment</span><span>Reports</span>
            </a>
          </div>
        </nav>
        <div class="mt-auto p-4 space-y-3">
          <div class="rounded-xl border border-primary/10 bg-primary/5 p-4">
            <p class="mb-1 text-xs font-semibold uppercase text-primary">Upcoming Deadline</p>
            <p class="text-sm font-medium text-slate-800">Phase 1 Submissions</p>
            <p class="mt-1 text-xs text-slate-500">Oct 24, 2023</p>
          </div>
          <form action="/logout" method="post">
            <button class="w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-white transition-all hover:bg-primary/90" type="submit">Sign Out</button>
          </form>
        </div>
      </aside>

      <main class="flex-1 lg:ml-64">
        <header class="sticky top-0 z-10 flex flex-col gap-2 border-b border-slate-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:h-16 sm:px-8 sm:py-0">
          <h1 class="text-lg font-bold">Student Project Proposals</h1>
          <p class="text-sm text-slate-500"><%= projects.filter((project) => (project.proposalStatus || "pending") !== "rejected").length %> proposal(s)</p>
        </header>

        <div class="space-y-6 p-4 sm:p-6 lg:p-8">
          <% if (error) { %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error %></div>
          <% } %>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <p class="text-xs font-semibold uppercase text-slate-500">Total Proposals</p>
              <p class="mt-2 text-2xl font-bold"><%= projects.filter((project) => (project.proposalStatus || "pending") !== "rejected").length %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <p class="text-xs font-semibold uppercase text-slate-500">Pending Reviews</p>
              <p class="mt-2 text-2xl font-bold"><%= projects.filter((project) => (project.proposalStatus || "pending") === "pending").length %></p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <p class="text-xs font-semibold uppercase text-slate-500">With Files</p>
              <p class="mt-2 text-2xl font-bold"><%= projects.filter((project) => (project.documents || []).length > 0).length %></p>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="flex flex-col gap-3 lg:flex-row">
              <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
                <input id="teacher-project-search" class="w-full rounded-lg border-none bg-slate-100 py-2.5 pl-10 pr-4 text-sm" placeholder="Search by student, title, domain, supervisor..." />
              </div>
              <select id="teacher-project-student-filter" class="min-w-64 rounded-lg border-none bg-slate-100 px-3 py-2.5 text-sm">
                <option value="all">All Students</option>
                <% teacherStudents.forEach(function(student) { %>
                  <option value="<%= student.studentId %>"><%= student.name %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-left">
                <thead>
                  <tr class="border-b border-slate-200 bg-slate-50">
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Student</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Project</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Supervisor</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100" id="teacher-project-table">
                  <% projects.forEach(function(project) { %>
                    <% if ((project.proposalStatus || "pending") !== "rejected") { %>
                      <tr class="hover:bg-slate-50" data-project-row data-student-id="<%= project.students?._id || '' %>" data-search="<%= `${project.title || ''} ${project.Domain || ''} ${project.supervisor || ''} ${project.students?.name || ''} ${project.students?.email || ''}`.toLowerCase() %>">
                        <td class="px-5 py-4">
                          <p class="text-sm font-semibold"><%= project.students?.name || "Unknown Student" %></p>
                          <p class="text-xs text-slate-500"><%= project.students?.email || "No email" %></p>
                        </td>
                        <td class="px-5 py-4">
                          <p class="text-sm font-semibold"><%= project.title %></p>
                          <p class="text-xs text-slate-500"><%= project.Domain || "-" %> | <%= (project.documents || []).length %> file(s)</p>
                        </td>
                        <td class="px-5 py-4 text-sm"><%= project.supervisor %></td>
                        <td class="px-5 py-4">
                          <span class="rounded-full px-2 py-1 text-xs font-semibold <%= (project.proposalStatus || 'pending') === 'accepted' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                            <%= (project.proposalStatus || "pending") === "accepted" ? "Accepted" : "Pending" %>
                          </span>
                        </td>
                        <td class="px-5 py-4">
                          <div class="flex flex-wrap items-center gap-2">
                            <button type="button" class="relative inline-flex items-center gap-1 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold hover:bg-slate-100" data-load-workspace="<%= project.students?._id %>" data-project-id="<%= project._id %>" data-project='<%- JSON.stringify(project) %>'>
                              <span class="material-symbols-outlined !text-[16px]">visibility</span>
                              View
                              <span class="hidden min-w-5 h-5 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white" data-project-badge></span>
                            </button>
                            <% if ((project.proposalStatus || "pending") === "pending") { %>
                              <button type="button" class="inline-flex items-center gap-1 rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100" data-review-project="<%= project._id %>" data-action="accept">Accept</button>
                              <button type="button" class="inline-flex items-center gap-1 rounded-lg border border-red-300 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100" data-review-project="<%= project._id %>" data-action="reject">Reject</button>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>

      <div id="teacher-workspace-panel" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
        <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-xl">
          <div class="flex items-start justify-between border-b border-slate-200 p-5">
            <div>
              <h2 class="text-lg font-bold text-slate-900">Proposal Details</h2>
              <p class="mt-1 text-xs text-slate-500">Student workspace and messages</p>
            </div>
            <button type="button" class="rounded-lg p-1.5 hover:bg-slate-100" data-close-workspace>
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
          <div class="space-y-4 p-5">
            <div id="teacher-workspace-content"></div>
            <form id="teacher-message-form" class="space-y-2">
              <input type="hidden" name="studentId" />
              <textarea class="w-full rounded-lg border border-slate-200 p-2 text-sm" rows="3" name="message" placeholder="Write a reply..." required></textarea>
              <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white">Send Reply</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <script>
      window.__teacherStudentUpdates = <%- JSON.stringify(teacherStudents) %>;
      window.__teacherId = <%- JSON.stringify(auth?.accountId || "") %>;
    </script>
  </body>
</html>
