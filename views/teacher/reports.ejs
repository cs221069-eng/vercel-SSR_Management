<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <% const reportData = data || {}; %>
    <% const summary = reportData.summary || {}; %>
    <% const rows = reportData.students || []; %>
    <% const monthly = reportData.monthlyActivity || []; %>
    <% const maxMonthly = Math.max(1, ...monthly.map((m) => (m.submissions || 0) + (m.studentMessages || 0) + (m.tasksCompleted || 0))); %>
    <div class="flex min-h-screen bg-background-light font-display text-slate-900">
      <aside class="fixed flex h-full w-64 flex-col border-r border-slate-200 bg-white">
        <div class="flex items-center gap-3 p-6">
          <div class="flex size-10 items-center justify-center rounded-lg bg-primary text-white">
            <span class="material-symbols-outlined">school</span>
          </div>
          <div>
            <h1 class="text-lg font-bold leading-tight text-primary">FYP Portal</h1>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Teacher Edition</p>
          </div>
        </div>
        <nav class="flex-1 space-y-1 px-4 py-4">
          <a href="/teacher-dashboard-1" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50"><span class="material-symbols-outlined">dashboard</span><span>Dashboard</span></a>
          <a href="/teacher-dashboard-2" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50"><span class="material-symbols-outlined">group</span><span>My Students</span></a>
          <a href="/teacher-projects" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50"><span class="material-symbols-outlined">assignment</span><span>Projects</span></a>
          <a href="/teacher-reports" class="flex items-center gap-3 rounded-lg bg-primary/10 px-3 py-2.5 font-semibold text-primary"><span class="material-symbols-outlined">assessment</span><span>Reports</span></a>
        </nav>
        <div class="mt-auto p-4">
          <form action="/logout" method="post">
            <button class="w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-white" type="submit">Sign Out</button>
          </form>
        </div>
      </aside>

      <main class="ml-64 flex-1">
        <header class="sticky top-0 z-10 flex h-16 items-center justify-between border-b border-slate-200 bg-white px-8">
          <h1 class="text-lg font-bold">Reports</h1>
          <div class="flex items-center gap-2">
            <button type="button" onclick="window.location.reload()" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold">Refresh</button>
            <button type="button" id="export-teacher-report" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white">Export CSV</button>
          </div>
        </header>

        <div class="space-y-6 p-8">
          <% if (error) { %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error %></div>
          <% } %>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs font-semibold uppercase text-slate-500">Students</p><p class="mt-2 text-2xl font-bold"><%= summary.totalStudents || 0 %></p></div>
            <div class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs font-semibold uppercase text-slate-500">Projects</p><p class="mt-2 text-2xl font-bold"><%= summary.totalProjects || 0 %></p></div>
            <div class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs font-semibold uppercase text-slate-500">Submissions</p><p class="mt-2 text-2xl font-bold"><%= summary.totalSubmissions || 0 %></p></div>
            <div class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs font-semibold uppercase text-slate-500">Completion</p><p class="mt-2 text-2xl font-bold"><%= summary.overallCompletionRate || 0 %>%</p></div>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
              <input id="teacher-reports-search" class="rounded-lg border-none bg-slate-100 px-3 py-2.5 text-sm" placeholder="Search student/project..." />
              <select id="teacher-reports-proposal" class="rounded-lg border-none bg-slate-100 px-3 py-2.5 text-sm">
                <option value="all">All Proposal Status</option>
                <option value="pending">Pending</option>
                <option value="accepted">Accepted</option>
                <option value="rejected">Rejected</option>
              </select>
              <select id="teacher-reports-committee" class="rounded-lg border-none bg-slate-100 px-3 py-2.5 text-sm">
                <option value="all">All Committee Status</option>
                <option value="not_started">Not Started</option>
                <option value="pending">Pending</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
              </select>
              <div class="rounded-lg bg-slate-100 px-3 py-2.5 text-sm"><span id="teacher-reports-count"><%= rows.length %></span> row(s)</div>
            </div>
          </div>

          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-left">
                <thead>
                  <tr class="border-b border-slate-200 bg-slate-50">
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Student</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Project</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Proposal</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Committee</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Tasks</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Submissions</th>
                    <th class="px-5 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Completion</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100" id="teacher-reports-table">
                  <% rows.forEach(function(row) { %>
                    <tr class="hover:bg-slate-50" data-report-row data-proposal="<%= row.proposalStatus || '' %>" data-committee="<%= row.committeeStatus || '' %>" data-search="<%= `${row.name || ''} ${row.email || ''} ${row.projectTitle || ''} ${row.department || ''}`.toLowerCase() %>">
                      <td class="px-5 py-4"><p class="text-sm font-semibold"><%= row.name %></p><p class="text-xs text-slate-500"><%= row.email %></p></td>
                      <td class="px-5 py-4 text-sm"><p><%= row.projectTitle || "-" %></p><p class="text-xs text-slate-500"><%= row.department || "-" %></p></td>
                      <td class="px-5 py-4 text-sm capitalize"><%= row.proposalStatus || "-" %></td>
                      <td class="px-5 py-4 text-sm capitalize"><%= row.committeeStatus || "-" %></td>
                      <td class="px-5 py-4 text-sm"><%= row.pendingTaskCount %> / <%= row.completedTaskCount %></td>
                      <td class="px-5 py-4 text-sm"><%= row.submissionCount %></td>
                      <td class="px-5 py-4 text-sm font-semibold"><%= row.completionRate %>%</td>
                    </tr>
                  <% }) %>
                  <% if (rows.length === 0) { %>
                    <tr><td class="px-5 py-4 text-sm text-slate-500" colspan="7">No report rows found.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="mb-4 text-lg font-bold">Monthly Activity (Last 6 Months)</h3>
            <div class="space-y-3">
              <% monthly.forEach(function(item) { %>
                <% const value = (item.submissions || 0) + (item.studentMessages || 0) + (item.tasksCompleted || 0); %>
                <% const width = Math.round((value / maxMonthly) * 100); %>
                <div>
                  <div class="mb-1 flex items-center justify-between text-xs">
                    <span class="font-semibold"><%= item.label %></span>
                    <span class="text-slate-500"><%= item.submissions %> submissions, <%= item.studentMessages %> messages, <%= item.tasksCompleted %> tasks completed</span>
                  </div>
                  <div class="h-2 overflow-hidden rounded-full bg-slate-100">
                    <div class="h-full rounded-full bg-primary" style="width: <%= width %>%"></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </main>
    </div>
    <script>
      window.__teacherReportRows = <%- JSON.stringify(rows) %>;
    </script>
  </body>
</html>
