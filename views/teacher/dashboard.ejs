<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <% const dashboard = data || {}; %>
    <% const summary = dashboard.summary || {}; %>
    <% const activities = dashboard.recentActivities || []; %>
    <div class="flex min-h-screen flex-col bg-background-light font-display text-slate-900 lg:flex-row">
      <aside class="flex w-full flex-col border-b border-slate-200 bg-white lg:fixed lg:h-full lg:w-64 lg:border-b-0 lg:border-r">
        <div class="flex items-center gap-3 p-6">
          <div class="flex size-10 items-center justify-center rounded-lg bg-primary text-white">
            <span class="material-symbols-outlined">school</span>
          </div>
          <div>
            <h1 class="text-lg font-bold leading-tight text-primary">FYP Portal</h1>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Teacher Edition</p>
          </div>
        </div>
        <nav class="flex-1 px-4 pb-4 lg:py-4 lg:pb-0">
          <div class="flex gap-2 overflow-x-auto pb-1 lg:block lg:space-y-1 lg:overflow-visible">
            <a href="/teacher-dashboard-1" class="flex items-center gap-3 rounded-lg bg-primary/10 px-3 py-2.5 font-semibold text-primary whitespace-nowrap"><span class="material-symbols-outlined">dashboard</span><span>Dashboard</span></a>
            <a href="/teacher-dashboard-2" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap"><span class="material-symbols-outlined">group</span><span>My Students</span></a>
            <a href="/teacher-projects" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap"><span class="material-symbols-outlined">assignment</span><span>Projects</span></a>
            <a href="/teacher-reports" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap"><span class="material-symbols-outlined">assessment</span><span>Reports</span></a>
          </div>
        </nav>
        <div class="mt-auto space-y-3 p-4">
          <div class="rounded-xl border border-primary/10 bg-primary/5 p-4">
            <p class="mb-1 text-xs font-semibold uppercase text-primary">Upcoming Deadline</p>
            <p class="text-sm font-medium text-slate-800">Phase 1 Submissions</p>
            <p class="mt-1 text-xs text-slate-500">Oct 24, 2023</p>
          </div>
          <form action="/logout" method="post">
            <button class="w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-white hover:bg-primary/90" type="submit">Sign Out</button>
          </form>
        </div>
      </aside>

      <main class="flex-1 lg:ml-64">
        <header class="sticky top-0 z-10 flex flex-col gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:py-0 sm:h-16 sm:px-8">
          <div class="relative w-full max-w-md">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
            <input class="w-full rounded-lg border-none bg-slate-100 py-2 pl-10 pr-4 text-sm" placeholder="Search activity..." type="text" />
          </div>
          <button type="button" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white" onclick="window.location.reload()">Refresh</button>
        </header>

        <div class="p-4 sm:p-6 lg:p-8">
          <div class="mb-8">
            <h2 class="text-2xl font-bold tracking-tight">Teacher Overview</h2>
            <p class="text-slate-500">Supervision analytics and latest student updates.</p>
          </div>

          <% if (error) { %>
            <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error %></div>
          <% } %>

          <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-slate-500">Assigned Students</p><h3 class="mt-2 text-3xl font-bold"><%= summary.assignedStudents || 0 %></h3></div>
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-slate-500">Pending Reviews</p><h3 class="mt-2 text-3xl font-bold"><%= summary.pendingReviews || 0 %></h3></div>
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-slate-500">Approved Projects</p><h3 class="mt-2 text-3xl font-bold"><%= summary.approvedProjects || 0 %></h3></div>
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-slate-500">Student Notifications</p><h3 class="mt-2 text-3xl font-bold"><%= summary.studentNotifications || 0 %></h3></div>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-4 text-lg font-bold">Recent Activity</h3>
            <div class="max-h-96 space-y-3 overflow-y-auto pr-1">
              <% if (activities.length === 0) { %><p class="text-sm text-slate-500">No activity found.</p><% } %>
              <% activities.forEach(function(activity) { %>
                <div class="rounded-lg border border-slate-200 p-3">
                  <p class="text-sm font-semibold"><%= activity.studentName || "Student" %></p>
                  <p class="text-sm text-slate-700"><%= activity.message %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= activity.createdAt ? new Date(activity.createdAt).toLocaleString() : "" %></p>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
