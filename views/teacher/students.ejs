<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
  </head>
  <body>
    <% const students = data.students || []; %>
    <div class="flex min-h-screen flex-col bg-background-light font-display text-slate-900 lg:flex-row">
      <aside class="flex w-full flex-col border-b border-slate-200 bg-white lg:fixed lg:h-full lg:w-64 lg:border-b-0 lg:border-r">
        <div class="flex items-center gap-3 p-6">
          <div class="flex size-10 items-center justify-center rounded-lg bg-primary text-white">
            <span class="material-symbols-outlined">school</span>
          </div>
          <div>
            <h1 class="text-lg font-bold leading-tight text-primary">FYP Portal</h1>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Teacher Edition</p>
          </div>
        </div>
        <nav class="flex-1 px-4 pb-4 lg:py-4 lg:pb-0">
          <div class="flex gap-2 overflow-x-auto pb-1 lg:block lg:space-y-1 lg:overflow-visible">
            <a href="/teacher-dashboard-1" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap"><span class="material-symbols-outlined">dashboard</span><span>Dashboard</span></a>
            <a href="/teacher-dashboard-2" class="flex items-center gap-3 rounded-lg bg-primary/10 px-3 py-2.5 font-semibold text-primary whitespace-nowrap"><span class="material-symbols-outlined">group</span><span>My Students</span></a>
            <a href="/teacher-projects" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap"><span class="material-symbols-outlined">assignment</span><span>Projects</span></a>
            <a href="/teacher-reports" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50 whitespace-nowrap"><span class="material-symbols-outlined">assessment</span><span>Reports</span></a>
          </div>
        </nav>
        <div class="mt-auto p-4">
          <form action="/logout" method="post"><button class="w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-white" type="submit">Sign Out</button></form>
        </div>
      </aside>

      <main class="flex-1 lg:ml-64">
        <header class="sticky top-0 z-10 flex flex-col gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:h-16 sm:px-8 sm:py-0">
          <h1 class="text-lg font-bold">Assigned Students</h1>
          <div class="flex w-full max-w-xl flex-col gap-3 sm:flex-row sm:items-center">
            <div class="relative flex-1">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
              <input id="teacher-students-search" class="w-full rounded-lg border-none bg-slate-100 py-2 pl-10 pr-4 text-sm" placeholder="Search student..." type="text" />
            </div>
            <button type="button" onclick="window.location.reload()" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white">Refresh</button>
          </div>
        </header>

        <div class="p-4 sm:p-6 lg:p-8">
          <% if (error) { %><div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error %></div><% } %>
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full border-collapse text-left">
              <thead>
                <tr class="border-b border-slate-200 bg-slate-50">
                  <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Student</th>
                  <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Project</th>
                  <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Department</th>
                  <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Tasks</th>
                  <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Submissions</th>
                  <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100" id="teacher-students-table">
                <% if (students.length === 0) { %><tr><td class="px-6 py-4 text-sm text-slate-500" colspan="6">No students found.</td></tr><% } %>
                <% students.forEach(function(student) { %>
                  <tr class="hover:bg-slate-50" data-teacher-student-row data-search="<%= `${student.name || ''} ${student.email || ''} ${student.projectTitle || ''} ${student.department || ''}`.toLowerCase() %>">
                    <td class="px-6 py-4"><p class="text-sm font-semibold"><%= student.name %></p><p class="text-xs text-slate-500"><%= student.email %></p></td>
                    <td class="px-6 py-4 text-sm"><%= student.projectTitle || "No project title" %></td>
                    <td class="px-6 py-4 text-sm"><%= student.department || "-" %></td>
                    <td class="px-6 py-4 text-sm"><%= student.pendingTasks || 0 %> pending / <%= student.completedTasks || 0 %> completed</td>
                    <td class="px-6 py-4 text-sm"><%= student.submissions || 0 %></td>
                    <td class="px-6 py-4"><span class="rounded-full bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-700"><%= student.projectStatus === "accepted" ? "Accepted" : student.projectStatus === "rejected" ? "Rejected" : "Pending" %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
